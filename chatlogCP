package com.emul8r.bizap.data.sync

import timber.log.Timber

/**
 * Resolves conflicts when local and server data diverge
 * Strategy: Last-Write-Wins
 */
class ConflictResolver {
    
    /**
     * Resolve conflict between local and server versions
     * Last-Write-Wins: whichever was modified more recently wins
     */
    fun <T> resolveConflict(
        localData: ConflictData,
        serverData: ConflictData
    ): ResolvedConflict {
        
        val localTimestamp = localData.updatedAt
        val serverTimestamp = serverData.updatedAt
        
        return when {
            serverTimestamp > localTimestamp -> {
                Timber.d("ConflictResolver: Server data is newer - using server version")
                ResolvedConflict(
                    winner = "server",
                    localTimestamp = localTimestamp,
                    serverTimestamp = serverTimestamp,
                    action = "UPDATE_LOCAL_FROM_SERVER"
                )
            }
            localTimestamp > serverTimestamp -> {
                Timber.d("ConflictResolver: Local data is newer - using local version")
                ResolvedConflict(
                    winner = "local",
                    localTimestamp = localTimestamp,
                    serverTimestamp = serverTimestamp,
                    action = "KEEP_LOCAL"
                )
            }
            else -> {
                // Same timestamp - use server (consistency)
                Timber.d("ConflictResolver: Same timestamp - using server version for consistency")
                ResolvedConflict(
                    winner = "server",
                    localTimestamp = localTimestamp,
                    serverTimestamp = serverTimestamp,
                    action = "UPDATE_LOCAL_FROM_SERVER"
                )
            }
        }
    }
    
    /**
     * Check if conflict occurred during sync
     */
    fun hasConflict(
        localVersion: Long,
        serverVersion: Long
    ): Boolean {
        return localVersion != serverVersion
    }
}

/**
 * Data for conflict resolution
 */
data class ConflictData(
    val id: Int,
    val entityType: String,
    val updatedAt: Long,
    val payload: String
)

/**
 * Result of conflict resolution
 */
data class ResolvedConflict(
    val winner: String, // "local" or "server"
    val localTimestamp: Long,
    val serverTimestamp: Long,
    val action: String // UPDATE_LOCAL_FROM_SERVER, KEEP_LOCAL, etc.
)
