package com.emul8r.bizap.data.network

import android.util.Log
import okhttp3.Interceptor
import okhttp3.Response
import java.io.IOException
import java.net.SocketTimeoutException
import java.net.UnknownHostException

/**
 * HTTP Interceptor that catches and logs API errors
 * Transforms raw HTTP errors into meaningful business errors
 */
class ErrorInterceptor : Interceptor {
    
    companion object {
        private const val TAG = "ErrorInterceptor"
    }
    
    override fun intercept(chain: Interceptor.Chain): Response {
        val request = chain.request()
        
        return try {
            val response = chain.proceed(request)
            
            // Check HTTP status codes
            when {
                response.code == 401 -> {
                    // Unauthorized - user needs to login again
                    Log.e(TAG, "Authentication error: ${response.code}")
                    throw ApiException.AuthenticationException("Invalid credentials. Please login again.")
                }
                
                response.code == 403 -> {
                    // Forbidden - user doesn't have permission
                    Log.e(TAG, "Permission error: ${response.code}")
                    throw ApiException.PermissionException("You don't have permission to access this resource.")
                }
                
                response.code == 404 -> {
                    // Not found
                    Log.e(TAG, "Resource not found: ${response.code}")
                    throw ApiException.NotFoundException("Resource not found.")
                }
                
                response.code in 400..499 -> {
                    // Client error
                    val errorBody = response.body?.string() ?: "Unknown error"
                    Log.e(TAG, "Client error ${response.code}: $errorBody")
                    throw ApiException.ClientException("Request failed: ${response.message}")
                }
                
                response.code in 500..599 -> {
                    // Server error
                    Log.e(TAG, "Server error: ${response.code}")
                    throw ApiException.ServerException("Server error. Please try again later.")
                }
                
                !response.isSuccessful -> {
                    // Any other error
                    Log.e(TAG, "Unexpected error: ${response.code}")
                    throw ApiException.UnknownException("An unexpected error occurred.")
                }
            }
            
            response
            
        } catch (e: SocketTimeoutException) {
            // Network timeout
            Log.e(TAG, "Network timeout: ${e.message}")
            throw ApiException.TimeoutException("Request timed out. Check your internet connection.")
            
        } catch (e: UnknownHostException) {
            // No internet / DNS resolution failed
            Log.e(TAG, "No internet connection: ${e.message}")
            throw ApiException.NetworkException("No internet connection. Check your network.")
            
        } catch (e: IOException) {
            // Generic network error
            Log.e(TAG, "Network error: ${e.message}")
            throw ApiException.NetworkException("Network error. Please try again.")
            
        } catch (e: ApiException) {
            // Re-throw our custom exceptions
            throw e
            
        } catch (e: Exception) {
            // Catch any other exception
            Log.e(TAG, "Unexpected exception: ${e.message}")
            throw ApiException.UnknownException("An unexpected error occurred: ${e.message}")
        }
    }
}
