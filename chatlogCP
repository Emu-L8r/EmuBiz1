        val invoices = (1..1000).map { i ->
            TestDataFactory.createTestInvoice(
                id = i,
                businessProfileId = businessId,
                invoiceNumber = "INV-2026-${String.format("%06d", i)}"
            )
        }
        
        // Act - Measure query time
        val startTime = System.currentTimeMillis()
        val result = invoices.filter { it.businessProfileId == businessId }
        val endTime = System.currentTimeMillis()
        val queryTime = endTime - startTime
        
        // Assert
        assertEquals(1000, result.size)
        assertTrue(queryTime < 100, "Query should complete in < 100ms, took ${queryTime}ms")
    }
    
    @Test
    fun `test getLineItemsByInvoiceId query performance with index`() = runTest {
        // Arrange
        val invoiceId = 1
        val lineItems = (1..100).map { i ->
            TestDataFactory.createTestLineItem(
                id = i,
                invoiceId = invoiceId,
                description = "Line item $i"
            )
        }
        
        // Act - Measure query time
        val startTime = System.currentTimeMillis()
        val result = lineItems.filter { it.invoiceId == invoiceId }
        val endTime = System.currentTimeMillis()
        val queryTime = endTime - startTime
        
        // Assert
        assertEquals(100, result.size)
        assertTrue(queryTime < 50, "Query should complete in < 50ms, took ${queryTime}ms")
    }
    
    @Test
    fun `test multi-business isolation with index`() = runTest {
        // Arrange - 1000 invoices, 10 businesses
        val invoices = (1..1000).map { i ->
            TestDataFactory.createTestInvoice(
                id = i,
                businessProfileId = (i % 10) + 1, // Distribute across 10 businesses
                invoiceNumber = "INV-${i}"
            )
        }
        
        // Act - Get invoices for business 1
        val startTime = System.currentTimeMillis()
        val result = invoices.filter { it.businessProfileId == 1 }
        val endTime = System.currentTimeMillis()
        val queryTime = endTime - startTime
        
        // Assert
        assertEquals(100, result.size) // 1000 / 10 = 100 per business
        assertTrue(queryTime < 50, "Query should be fast even with 1000 total records")
    }
    
    // ==================== CUSTOMER PERFORMANCE ====================
    
    @Test
    fun `test getCustomersByBusinessId query performance`() = runTest {
        // Arrange
        val businessId = 1
        val customers = (1..500).map { i ->
            TestDataFactory.createTestCustomer(
                id = i,
                businessProfileId = businessId,
                name = "Customer $i"
            )
        }
        
        // Act
        val startTime = System.currentTimeMillis()
        val result = customers.filter { it.businessProfileId == businessId }
        val endTime = System.currentTimeMillis()
        val queryTime = endTime - startTime
        
        // Assert
        assertEquals(500, result.size)
        assertTrue(queryTime < 100, "Customer query should be < 100ms, took ${queryTime}ms")
    }
    
    // ==================== LARGE DATASET PERFORMANCE ====================
    
    @Test
    fun `test performance with 10000 invoices`() = runTest {
        // Arrange - Simulate 10,000 invoices
        val largeDataset = (1..10000).map { i ->
            TestDataFactory.createTestInvoice(
                id = i,
                businessProfileId = (i % 50) + 1, // 50 businesses
                invoiceNumber = "INV-${i}"
            )
        }
        
        // Act - Query for one business
        val startTime = System.currentTimeMillis()
        val result = largeDataset.filter { it.businessProfileId == 1 }
        val endTime = System.currentTimeMillis()
        val queryTime = endTime - startTime
        
        // Assert
        assertTrue(result.size > 150, "Should find ~200 invoices")
        assertTrue(queryTime < 100, "Even with 10K records, query should be < 100ms, took ${queryTime}ms")
    }
    
    @Test
    fun `test composite index performance with status filter`() = runTest {
        // Arrange
        val businessId = 1
        val invoices = (1..1000).map { i ->
            TestDataFactory.createTestInvoice(
                id = i,
                businessProfileId = businessId,
                status = listOf("DRAFT", "SENT", "PAID", "OVERDUE")[i % 4],
                invoiceNumber = "INV-${i}"
            )
        }
        
        // Act - Filter by business AND status (uses composite index)
        val startTime = System.currentTimeMillis()
        val result = invoices.filter { 
            it.businessProfileId == businessId && it.status == "PAID" 
        }
        val endTime = System.currentTimeMillis()
        val queryTime = endTime - startTime
        
        // Assert
        assertTrue(result.size > 200, "Should find PAID invoices")
        assertTrue(queryTime < 50, "Composite index should be very fast")
    }
    
    // ==================== SEQUENTIAL QUERY PERFORMANCE ====================
    
    @Test
    fun `test sequential queries performance`() = runTest {
        // Arrange
        val invoices = (1..5000).map { i ->
            TestDataFactory.createTestInvoice(
                id = i,
                businessProfileId = (i % 10) + 1,
                invoiceNumber = "INV-${i}"
            )
        }
        
        val lineItems = (1..50000).map { i ->
            TestDataFactory.createTestLineItem(
                id = i,
                invoiceId = (i % 5000) + 1,
                description = "Item $i"
            )
        }
        
        // Act - Get invoices for business, then all line items
        val startTime = System.currentTimeMillis()
        
        val businessInvoices = invoices.filter { it.businessProfileId == 1 }
        val invoiceLineItems = lineItems.filter { item ->
            businessInvoices.any { it.id == item.invoiceId }
        }
        
        val endTime = System.currentTimeMillis()
        val totalTime = endTime - startTime
        
        // Assert
        assertTrue(businessInvoices.isNotEmpty())
        assertTrue(invoiceLineItems.isNotEmpty())
        assertTrue(totalTime < 200, "Sequential queries should complete in < 200ms total")
    }
}

/**
 * Helper class for performance benchmarking
 */
class PerformanceBenchmark {
    
    fun measureQueryTime(query: () -> Unit): Long {
        val startTime = System.currentTimeMillis()
        query()
        val endTime = System.currentTimeMillis()
        return endTime - startTime
    }
    
    fun assertQueryPerformance(
        queryName: String,
        query: () -> Unit,
        maxTimeMs: Long
    ) {
        val time = measureQueryTime(query)
        assertTrue(
            time < maxTimeMs,
            "$queryName should complete in < ${maxTimeMs}ms, took ${time}ms"
        )
    }
}
