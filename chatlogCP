@HiltViewModel
class RevenueDashboardViewModel @Inject constructor(
    private val getRevenueMetricsUseCase: GetRevenueMetricsUseCase,
    private val errorHandler: ErrorHandler
) : ViewModel() {
    
    // State
    private val _state = MutableStateFlow<RevenueDashboardState>(
        RevenueDashboardState.Loading
    )
    val state: StateFlow<RevenueDashboardState> = _state.asStateFlow()
    
    // Current business ID (get from context or pass in)
    private val businessId = "current-business-id"
    
    init {
        loadRevenueMetrics()
    }
    
    private fun loadRevenueMetrics() {
        viewModelScope.launch {
            try {
                _state.value = RevenueDashboardState.Loading
                val metrics = getRevenueMetricsUseCase.execute(businessId)
                _state.value = RevenueDashboardState.Success(metrics)
            } catch (e: Exception) {
                val message = errorHandler.handle(e)
                _state.value = RevenueDashboardState.Error(message)
            }
        }
    }
    
    fun onRefresh() {
        loadRevenueMetrics()
    }
}

sealed class RevenueDashboardState {
    object Loading : RevenueDashboardState()
    data class Success(val metrics: RevenueMetrics) : RevenueDashboardState()
    data class Error(val message: String) : RevenueDashboardState()
}
