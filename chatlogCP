package com.emul8r.bizap.data.backup

import android.content.Context
import com.emul8r.bizap.data.local.dao.InvoiceDao
import com.emul8r.bizap.data.local.dao.CustomerDao
import com.emul8r.bizap.data.local.dao.LineItemDao
import com.google.gson.Gson
import com.google.gson.GsonBuilder
import dagger.hilt.android.qualifiers.ApplicationContext
import timber.log.Timber
import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream
import javax.inject.Inject
import javax.inject.Singleton
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

/**
 * Service for creating and restoring backups
 */
@Singleton
class BackupService @Inject constructor(
    @ApplicationContext private val context: Context,
    private val invoiceDao: InvoiceDao,
    private val customerDao: CustomerDao,
    private val lineItemDao: LineItemDao,
    private val gson: Gson
) {
    
    companion object {
        private const val TAG = "BackupService"
        const val BACKUP_DIR = "backups"
        const val BACKUP_EXTENSION = ".json"
        const val BACKUP_ZIP_EXTENSION = ".zip"
        const val CSV_EXTENSION = ".csv"
    }
    
    private val backupDir = File(context.getExternalFilesDir(null), BACKUP_DIR)
    
    init {
        if (!backupDir.exists()) {
            backupDir.mkdirs()
        }
    }
    
    /**
     * Create full JSON backup of all data
     */
    suspend fun createJsonBackup(): File = withContext(Dispatchers.IO) {
        try {
            Timber.d("BackupService: Creating JSON backup...")
            
            // Fetch all data
            val invoices = invoiceDao.getAllInvoices()
            val customers = customerDao.getAllCustomers()
            val lineItems = lineItemDao.getAllLineItems()
            
            // Convert to backup format
            val invoiceBackups = invoices.map { invoice ->
                InvoiceBackup(
                    id = invoice.id,
                    businessProfileId = invoice.businessProfileId,
                    customerId = invoice.customerId,
                    invoiceNumber = invoice.invoiceNumber,
                    currencyCode = invoice.currencyCode,
                    subtotal = invoice.subtotal,
                    taxAmount = invoice.taxAmount,
                    totalAmount = invoice.totalAmount,
                    status = invoice.status,
                    createdAt = invoice.createdAt,
                    updatedAt = invoice.updatedAt
                )
            }
            
            val customerBackups = customers.map { customer ->
                CustomerBackup(
                    id = customer.id,
                    businessProfileId = customer.businessProfileId,
                    name = customer.name,
                    email = customer.email,
                    phone = customer.phone,
                    address = customer.address,
                    createdAt = customer.createdAt,
                    updatedAt = customer.updatedAt
                )
            }
            
            val lineItemBackups = lineItems.map { item ->
                LineItemBackup(
                    id = item.id,
                    invoiceId = item.invoiceId,
                    description = item.description,
                    quantity = item.quantity,
                    unitPrice = item.unitPrice,
                    createdAt = item.createdAt
                )
            }
            
            // Create snapshot
            val snapshot = BackupSnapshot(
                invoices = invoiceBackups,
                customers = customerBackups,
                lineItems = lineItemBackups,
                metadata = BackupMetadata(
                    invoiceCount = invoiceBackups.size,
                    customerCount = customerBackups.size,
                    lineItemCount = lineItemBackups.size,
                    businessCount = customerBackups.map { it.businessProfileId }.distinct().size
                )
            )
            
            // Write to file
            val timestamp = SimpleDateFormat("yyyy-MM-dd_HHmmss", Locale.US).format(Date())
            val backupFile = File(backupDir, "backup_$timestamp$BACKUP_EXTENSION")
            
            backupFile.writeText(gson.toJson(snapshot))
            
            Timber.d("BackupService: JSON backup created: ${backupFile.absolutePath}")
            
            return@withContext backupFile
            
        } catch (e: Exception) {
            Timber.e("BackupService: Failed to create JSON backup: ${e.message}")
            throw e
        }
    }
    
    /**
     * Create CSV export of invoices
     */
    suspend fun createCsvBackup(): File = withContext(Dispatchers.IO) {
        try {
            Timber.d("BackupService: Creating CSV backup...")
            
            val invoices = invoiceDao.getAllInvoices()
            
            val timestamp = SimpleDateFormat("yyyy-MM-dd_HHmmss", Locale.US).format(Date())
            val csvFile = File(backupDir, "invoices_$timestamp$CSV_EXTENSION")
            
            val csvContent = StringBuilder()
            
            // Write header
            csvContent.append("ID,BusinessID,CustomerID,InvoiceNumber,Currency,Subtotal,Tax,Total,Status,Created,Updated\n")
            
            // Write data
            invoices.forEach { invoice ->
                csvContent.append("${invoice.id},")
                csvContent.append("${invoice.businessProfileId},")
                csvContent.append("${invoice.customerId},")
                csvContent.append("\"${invoice.invoiceNumber}\",")
                csvContent.append("${invoice.currencyCode},")
                csvContent.append("${invoice.subtotal},")
                csvContent.append("${invoice.taxAmount},")
                csvContent.append("${invoice.totalAmount},")
                csvContent.append("${invoice.status},")
                csvContent.append("${invoice.createdAt},")
                csvContent.append("${invoice.updatedAt}\n")
            }
            
            csvFile.writeText(csvContent.toString())
            
            Timber.d("BackupService: CSV backup created: ${csvFile.absolutePath}")
            
            return@withContext csvFile
            
        } catch (e: Exception) {
            Timber.e("BackupService: Failed to create CSV backup: ${e.message}")
            throw e
        }
    }
    
    /**
     * Get list of existing backups
     */
    fun getBackupsList(): List<File> {
        return backupDir.listFiles()?.filter { 
            it.extension == BACKUP_EXTENSION.removePrefix(".") 
        }?.sortedByDescending { it.lastModified() } ?: emptyList()
    }
    
    /**
     * Delete old backups (keep last N)
     */
    suspend fun cleanupOldBackups(keepCount: Int = 7) = withContext(Dispatchers.IO) {
        try {
            val backups = getBackupsList()
            
            if (backups.size > keepCount) {
                val toDelete = backups.drop(keepCount)
                toDelete.forEach { file ->
                    if (file.delete()) {
                        Timber.d("BackupService: Deleted old backup: ${file.name}")
                    }
                }
            }
        } catch (e: Exception) {
            Timber.e("BackupService: Failed to cleanup backups: ${e.message}")
        }
    }
    
    /**
     * Get backup file size in MB
     */
    fun getBackupSize(file: File): Double {
        return file.length() / (1024.0 * 1024.0) // Convert to MB
    }
    
    /**
     * Share backup file
     */
    fun getBackupShareUri(file: File): String {
        return file.absolutePath
    }
}
