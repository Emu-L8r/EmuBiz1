import androidx.room.Entity
import androidx.room.Index

@Entity(
    tableName = "invoices",
    indices = [
        Index(name = "idx_invoices_business", value = ["businessProfileId"]),
        Index(name = "idx_invoices_customer", value = ["customerId"]),
        Index(name = "idx_invoices_status", value = ["status"]),
        Index(
            name = "idx_invoices_business_status",
            value = ["businessProfileId", "status"]
        ) // Composite for filtering by business + status
    ]
)
data class Invoice(
    @PrimaryKey(autoGenerate = true)
    val id: Int = 0,
    
    val businessProfileId: Int,
    val customerId: Int,
    val invoiceNumber: String,
    val currencyCode: String,
    val subtotal: Double,
    val taxAmount: Double,
    val totalAmount: Double,
    val status: String, // DRAFT, SENT, PAID, OVERDUE, PARTIALLY_PAID
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis(),
    val lineItems: List<LineItem> = emptyList(),
    val isQuote: Boolean = false
) {
    fun validate() {
        require(businessProfileId > 0) { "Business ID must be positive" }
        require(customerId > 0) { "Customer ID must be positive" }
        require(invoiceNumber.isNotBlank()) { "Invoice number cannot be blank" }
        require(currencyCode.length == 3) { "Currency code must be exactly 3 characters" }
        require(totalAmount > 0.01) { "Total amount must be greater than 0.01" }
        require(status in listOf("DRAFT", "SENT", "PAID", "OVERDUE", "PARTIALLY_PAID")) {
            "Status must be DRAFT, SENT, PAID, OVERDUE, or PARTIALLY_PAID"
        }
        lineItems.forEach { it.validate() }
    }
}
