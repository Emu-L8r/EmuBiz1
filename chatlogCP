package com.emul8r.bizap.data.sync

import android.content.Context
import androidx.work.Constraints
import androidx.work.ExistingWorkPolicy
import androidx.work.NetworkType
import androidx.work.OneTimeWorkRequestBuilder
import androidx.work.WorkManager
import timber.log.Timber

/**
 * Schedules sync work with WorkManager
 */
class SyncScheduler(private val context: Context) {
    
    private val workManager = WorkManager.getInstance(context)
    
    /**
     * Schedule sync when connectivity returns
     * Requires: Network connectivity
     */
    fun scheduleSyncOnConnectivity() {
        Timber.d("SyncScheduler: Scheduling sync when online...")
        
        // Build sync request
        val syncRequest = OneTimeWorkRequestBuilder<SyncWorker>()
            .setConstraints(
                Constraints.Builder()
                    .setRequiredNetworkType(NetworkType.CONNECTED) // Wait for network
                    .setRequiresBatteryNotLow(false) // Allow on low battery
                    .build()
            )
            .build()
        
        // Enqueue with KEEP_AS_IS to avoid duplicate runs
        workManager.enqueueUniqueWork(
            SyncWorker.UNIQUE_WORK_NAME,
            ExistingWorkPolicy.KEEP,
            syncRequest
        )
        
        Timber.d("SyncScheduler: Sync scheduled")
    }
    
    /**
     * Schedule immediate sync (for manual user action)
     */
    fun scheduleImmediateSync() {
        Timber.d("SyncScheduler: Scheduling immediate sync...")
        
        val syncRequest = OneTimeWorkRequestBuilder<SyncWorker>()
            .build()
        
        workManager.enqueueUniqueWork(
            SyncWorker.UNIQUE_WORK_NAME,
            ExistingWorkPolicy.KEEP,
            syncRequest
        )
        
        Timber.d("SyncScheduler: Immediate sync scheduled")
    }
    
    /**
     * Cancel pending sync work
     */
    fun cancelSync() {
        Timber.d("SyncScheduler: Cancelling pending sync...")
        workManager.cancelUniqueWork(SyncWorker.UNIQUE_WORK_NAME)
    }
    
    /**
     * Observe sync progress
     */
    fun observeSyncProgress() = workManager.getWorkInfosForTagLiveData(SyncWorker.SYNC_PROGRESS_TAG)
}
