### **The Migration Process (Behind the Scenes)**

Kotlin

```
val migration_1_to_2 = object : Migration(1, 2) {
    override fun migrate(database: SupportSQLiteDatabase) {
        // SQL: Add new columns to existing table
        database.execSQL("ALTER TABLE invoice ADD COLUMN customerName TEXT NOT NULL DEFAULT ''")
        database.execSQL("ALTER TABLE invoice ADD COLUMN customerAddress TEXT NOT NULL DEFAULT ''")
    }
}

val migration_2_to_3 = object : Migration(2, 3) {
    override fun migrate(database: SupportSQLiteDatabase) {
        database.execSQL("ALTER TABLE invoice ADD COLUMN invoiceNumber TEXT NOT NULL DEFAULT ''")
