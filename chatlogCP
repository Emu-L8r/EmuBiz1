package com.emul8r.bizap.data.repository

import com.emul8r.bizap.BaseUnitTest
import com.emul8r.bizap.util.TestDataFactory
import io.mockk.coEvery
import io.mockk.mockk
import kotlinx.coroutines.test.runTest
import org.junit.Before
import org.junit.Test
import kotlin.test.assertEquals
import kotlin.test.assertTrue

/**
 * Unit tests for InvoiceRepository
 * Verifies multi-business isolation and invoice operations
 */
class InvoiceRepositoryTest : BaseUnitTest() {
    
    private lateinit var invoiceDao: MockInvoiceDao
    private lateinit var repository: InvoiceRepository
    
    @Before
    fun setup() {
        invoiceDao = mockk()
        repository = InvoiceRepository(invoiceDao)
    }
    
    @Test
    fun `test get invoices by business id filters correctly`() = runTest {
        // Arrange
        val businessId = 1
        val testInvoices = listOf(
            TestDataFactory.createTestInvoice(id = 1, businessProfileId = businessId),
            TestDataFactory.createTestInvoice(id = 2, businessProfileId = businessId),
            TestDataFactory.createTestInvoice(id = 3, businessProfileId = 2) // Different business
        )
        
        coEvery { invoiceDao.getInvoicesByBusinessId(businessId) } returns testInvoices.filter { 
            it.businessProfileId == businessId 
        }
        
        // Act
        val result = repository.getInvoicesByBusinessId(businessId)
        
        // Assert
        assertEquals(2, result.size)
        assertTrue(result.all { it.businessProfileId == businessId })
    }
    
    @Test
    fun `test business isolation prevents data leakage`() = runTest {
        // Arrange
        val business1Id = 1
        val business2Id = 2
        
        val business1Invoices = listOf(
            TestDataFactory.createTestInvoice(id = 1, businessProfileId = business1Id, amount = 1000.0),
            TestDataFactory.createTestInvoice(id = 2, businessProfileId = business1Id, amount = 2000.0)
        )
        
        val business2Invoices = listOf(
            TestDataFactory.createTestInvoice(id = 3, businessProfileId = business2Id, amount = 5000.0)
        )
        
        coEvery { invoiceDao.getInvoicesByBusinessId(business1Id) } returns business1Invoices
        coEvery { invoiceDao.getInvoicesByBusinessId(business2Id) } returns business2Invoices
        
        // Act
        val result1 = repository.getInvoicesByBusinessId(business1Id)
        val result2 = repository.getInvoicesByBusinessId(business2Id)
        
        // Assert
        assertEquals(2, result1.size)
        assertEquals(1, result2.size)
        assertTrue(result1.none { it.businessProfileId == business2Id })
        assertTrue(result2.none { it.businessProfileId == business1Id })
    }
    
    @Test
    fun `test invoice sequence is independent per business`() = runTest {
        // Arrange - Both businesses have invoice INV-2026-000001
        val business1Invoice = TestDataFactory.createTestInvoice(
            businessProfileId = 1,
            invoiceNumber = "INV-2026-000001"
