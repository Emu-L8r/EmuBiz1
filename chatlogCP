package com.emul8r.bizap.data.repository

import android.util.Log
import com.emul8r.bizap.data.network.ApiException
import com.emul8r.bizap.domain.models.ApiResult
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

/**
 * Base repository with built-in error handling
 * All API calls should use this to wrap responses
 */
abstract class ErrorHandlingRepository {
    
    companion object {
        private const val TAG = "ErrorHandlingRepository"
    }
    
    /**
     * Safely execute an API call and wrap result
     * Returns ApiResult.Success on success
     * Returns ApiResult.Error on any exception
     */
    suspend fun <T> safeApiCall(
        apiCall: suspend () -> T
    ): ApiResult<T> = withContext(Dispatchers.IO) {
        return@withContext try {
            val result = apiCall()
