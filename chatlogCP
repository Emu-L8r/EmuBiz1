        val testMetrics = testRevenueMetrics()
        coEvery { useCase.execute(any()) } returns testMetrics
        
        val state = viewModel.state.first()
        
        assertTrue(state is RevenueDashboardState.Success)
        assertEquals(testMetrics, (state as RevenueDashboardState.Success).metrics)
    }
    
    @Test
    fun `when error should show error state`() = runTest {
        coEvery { useCase.execute(any()) } throws Exception("Test error")
        coEvery { errorHandler.handle(any()) } returns "Error occurred"
        
        val state = viewModel.state.first()
        
        assertTrue(state is RevenueDashboardState.Error)
    }
    
    @Test
    fun `on refresh should reload data`() = runTest {
        val testMetrics = testRevenueMetrics()
        coEvery { useCase.execute(any()) } returns testMetrics
        
