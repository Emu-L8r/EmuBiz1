package com.emul8r.bizap.domain.models

/**
 * Sealed class representing the result of an API call
 * Either Success with data, or Error with details
 */
sealed class ApiResult<T> {
    
    data class Success<T>(val data: T) : ApiResult<T>()
    
    data class Error<T>(
        val code: String,
        val message: String,
        val throwable: Throwable? = null
    ) : ApiResult<T>()
    
    // Helper functions
    fun isSuccess(): Boolean = this is Success
    fun isError(): Boolean = this is Error
    
    fun getOrNull(): T? = when (this) {
        is Success -> data
        is Error -> null
    }
    
    fun getError(): Error<T>? = when (this) {
        is Success -> null
        is Error -> this
    }
}
