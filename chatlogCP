data class CustomerDetailState(
    val customer: Customer? = null,
    val timeline: List<TimelineItem> = emptyList(),
    val isLoading: Boolean = false,
    val error: String? = null,
    val notes: String = ""
)

class CustomerDetailViewModel @HiltViewModel constructor(
    private val customerRepository: CustomerRepository,
    private val invoiceRepository: InvoiceRepository,
    savedStateHandle: SavedStateHandle
) : ViewModel() {

    private val customerId = savedStateHandle.get<Long>("customerId") ?: 0L
    
    private val _state = MutableStateFlow(CustomerDetailState())
    val state = _state.asStateFlow()

    init {
        loadCustomerAndTimeline()
    }

    private fun loadCustomerAndTimeline() {
        viewModelScope.launch {
            try {
                _state.update { it.copy(isLoading = true) }
                
                val customer = customerRepository.getCustomerById(customerId)
                val invoices = invoiceRepository.getInvoicesByCustomerId(customerId)
                
                // Build timeline
                val timelineItems = mutableListOf<TimelineItem>()
                
                // Add invoices to timeline
                invoices.forEach { invoice ->
                    timelineItems.add(TimelineItem.InvoiceItem(
                        invoiceId = invoice.id,
                        invoiceNumber = invoice.invoiceNumber,
                        amount = invoice.total,
                        status = invoice.status,
                        timestamp = invoice.createdAt
                    ))
                }
                
                // Add customer notes to timeline
                if (customer.notes.isNotEmpty()) {
                    timelineItems.add(TimelineItem.NoteItem(
                        noteContent = customer.notes,
                        timestamp = customer.updatedAt
                    ))
                }
                
                // Sort by timestamp (newest first)
                timelineItems.sortByDescending { it.timestamp }
                
                _state.update { 
                    it.copy(
                        customer = customer,
                        timeline = timelineItems,
                        notes = customer.notes,
                        isLoading = false
                    )
                }
            } catch (e: Exception) {
                _state.update { 
                    it.copy(
                        error = e.message,
                        isLoading = false
                    )
                }
            }
        }
    }

    fun updateNotes(newNotes: String) {
        _state.update { it.copy(notes = newNotes) }
    }

    fun saveNotes() {
        viewModelScope.launch {
            try {
                _state.value.customer?.let { customer ->
                    val updatedCustomer = customer.copy(
                        notes = _state.value.notes,
                        updatedAt = System.currentTimeMillis()
                    )
                    customerRepository.updateCustomer(updatedCustomer)
                    loadCustomerAndTimeline()  // Refresh timeline
                }
            } catch (e: Exception) {
                _state.update { it.copy(error = e.message) }
            }
        }
    }

    fun deleteCustomer() {
        // Existing delete logic
    }
}
