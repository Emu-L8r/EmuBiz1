package com.emul8r.bizap.data.mapper

import com.emul8r.bizap.BaseUnitTest
import com.emul8r.bizap.util.TestDataFactory
import org.junit.Test
import kotlin.test.assertEquals

/**
 * Unit tests for InvoiceMapper
 * Verifies entity <-> domain mapping works correctly
 */
class InvoiceMapperTest : BaseUnitTest() {
    
    @Test
    fun `test invoice to entity mapping preserves all fields`() {
        // Arrange
        val invoice = TestDataFactory.createTestInvoice(
            id = 1,
            businessProfileId = 1,
            invoiceNumber = "INV-2026-000001",
            currencyCode = "AUD"
        )
        
        // Act
        val entity = invoice.toEntity()
        
        // Assert
        assertEquals(invoice.id, entity.id)
        assertEquals(invoice.businessProfileId, entity.businessProfileId)
        assertEquals(invoice.invoiceNumber, entity.invoiceNumber)
        assertEquals(invoice.currencyCode, entity.currencyCode)
    }
    
    @Test
    fun `test business profile id preserved during mapping`() {
        // This is critical for multi-business scoping
        val businessId = 42
        val invoice = TestDataFactory.createTestInvoice(businessProfileId = businessId)
        
        val entity = invoice.toEntity()
        
        assertEquals(businessId, entity.businessProfileId)
    }
}
```

