// app/src/main/java/com/emul8r/bizap/data/repository/

class RevenueRepositoryImpl @Inject constructor(
    private val analyticsDao: AnalyticsDao
) : RevenueRepository {
    
    override suspend fun getRevenueMetrics(businessId: String): RevenueMetrics {
        return withContext(Dispatchers.IO) {
            try {
                // Use existing AnalyticsDao methods
                val mtdData = analyticsDao.getDailyRevenueSnapshot()
                
                // Calculate metrics
                val mtd = calculateMTD(mtdData)
                val ytd = calculateYTD(mtdData)
                val weekly = calculateWeekly(mtdData)
                val dailyTrend = transformToDailyData(mtdData)
                val currencyMap = calculateByCurrency(mtdData)
                
                RevenueMetrics(
                    mtdRevenue = mtd,
                    ytdRevenue = ytd,
                    weeklyRevenue = weekly,
                    dailyRevenue = dailyTrend,
                    currencyTotals = currencyMap
                )
            } catch (e: Exception) {
                throw DataAccessException("Failed to get revenue metrics", e)
            }
        }
    }
    
    private fun calculateMTD(data: List<DailyRevenueSnapshot>): Double {
        val today = LocalDate.now()
        return data
            .filter { 
                it.date.month == today.month && 
                it.date.year == today.year 
            }
            .sumOf { it.totalRevenue }
    }
    
    private fun calculateYTD(data: List<DailyRevenueSnapshot>): Double {
        val today = LocalDate.now()
        return data
            .filter { it.date.year == today.year }
            .sumOf { it.totalRevenue }
    }
    
    private fun calculateWeekly(data: List<DailyRevenueSnapshot>): Double {
        val sevenDaysAgo = LocalDate.now().minusDays(7)
        return data
            .filter { it.date.isAfter(sevenDaysAgo) || it.date == sevenDaysAgo }
            .sumOf { it.totalRevenue }
    }
    
    private fun transformToDailyData(
        snapshots: List<DailyRevenueSnapshot>
    ): List<DailyRevenueData> {
        return snapshots
            .sortedBy { it.date }
            .map { 
                DailyRevenueData(
                    date = it.date,
                    amount = it.totalRevenue,
                    invoiceCount = it.invoiceCount
                )
            }
    }
    
    private fun calculateByCurrency(
        data: List<DailyRevenueSnapshot>
    ): Map<String, Double> {
        return data
            .groupBy { it.currency }
            .mapValues { (_, snapshots) ->
                snapshots.sumOf { it.totalRevenue }
            }
    }
}
