import com.emul8r.bizap.data.model.DailyRevenuePoint
import com.emul8r.bizap.data.model.RevenueByCurrency
import com.emul8r.bizap.data.model.DailyRevenueSnapshot
import com.emul8r.bizap.data.persistence.AnalyticsDao
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONArray
import org.json.JSONObject
import timber.log.Timber
import java.time.LocalDate
import java.time.YearMonth
import javax.inject.Inject
import javax.persistence.PersistenceException

class RevenueRepositoryImpl @Inject constructor(private val analyticsDao: AnalyticsDao) {

    suspend fun getRevenueStats(startDate: LocalDate, endDate: LocalDate): RevenueStats {
        return withContext(Dispatchers.IO) {
            try {
                val dailySnapshots = analyticsDao.getDailyRevenueSnapshots(startDate, endDate)
                val mtd = calculateMTD(dailySnapshots)
                val ytd = calculateYTD(dailySnapshots)
                val weeklyTotal = calculateWeeklyRevenue(dailySnapshots)
                RevenueStats(mtd, ytd, weeklyTotal)
            } catch (e: Exception) {
                Timber.e(e, "Error retrieving revenue stats")
                throw DataAccessException("Error retrieving revenue stats", e)
            }
        }
    }

    private fun calculateMTD(dailySnapshots: List<DailyRevenueSnapshot>): Double {
        return dailySnapshots.sumOf { it.revenue } 
    }

    private fun calculateYTD(dailySnapshots: List<DailyRevenueSnapshot>): Double {
        return dailySnapshots.sumOf { it.revenue } 
    }

    private fun calculateWeeklyRevenue(dailySnapshots: List<DailyRevenueSnapshot>): Double {
        val currentWeek = YearMonth.now().atDay(1).dayOfWeek
        return dailySnapshots.filter { it.date.dayOfWeek == currentWeek }
            .sumOf { it.revenue }
    }

    fun parseCurrencyBreakdown(json: String): Map<String, Double> {
        val currencyMap = mutableMapOf<String, Double>()
        val jsonArray = JSONArray(json)
        for (i in 0 until jsonArray.length()) {
            val obj = jsonArray.getJSONObject(i)
            val currency = obj.getString("currency")
            val amount = obj.getDouble("amount")
            currencyMap[currency] = amount
        }
        return currencyMap
    }
}

data class RevenueStats(val mtd: Double, val ytd: Double, val weeklyTotal: Double)
