package com.emul8r.bizap.data.repository

import com.emul8r.bizap.data.local.dao.PendingOperationDao
import com.emul8r.bizap.data.local.entity.PendingOperation
import com.google.gson.Gson
import kotlinx.coroutines.flow.Flow
import timber.log.Timber
import java.util.UUID

/**
 * Manages the queue of pending operations that need to sync to server
 * Operations are stored locally when offline, synced when online
 */
class OfflineSyncQueue(
    private val pendingOperationDao: PendingOperationDao,
    private val gson: Gson
) {
    
    /**
     * Queue an operation to sync later
     * Called when user tries to create/update/delete offline
     */
    suspend fun queueOperation(
        operationType: String, // CREATE, UPDATE, DELETE
        entityType: String, // INVOICE, CUSTOMER, LINE_ITEM
        businessProfileId: Int,
        payload: Any,
        entityId: Int? = null
    ): String {
        val payloadJson = gson.toJson(payload)
        
        val operation = PendingOperation(
            id = UUID.randomUUID().toString(),
            operationType = operationType,
            entityType = entityType,
            entityId = entityId,
            businessProfileId = businessProfileId,
            payload = payloadJson,
            status = "PENDING"
        )
        
        pendingOperationDao.insertPendingOperation(operation)
        
        Timber.d("Queued operation: $operationType $entityType (${operation.id})")
        
        return operation.id
    }
    
    /**
     * Get all pending operations for a business
     */
    suspend fun getPendingOperations(businessProfileId: Int): List<PendingOperation> {
        return pendingOperationDao.getPendingOperationsForBusiness(businessProfileId)
    }
    
    /**
     * Get all pending operations (any business)
     */
    suspend fun getAllPendingOperations(): List<PendingOperation> {
        return pendingOperationDao.getPendingOperations()
    }
    
    /**
     * Observe pending operations count
     * Useful for UI to show "X operations pending"
     */
    fun observePendingCount(): Flow<Int> {
        return pendingOperationDao.observePendingCount()
    }
    
    /**
     * Mark operation as syncing
     */
    suspend fun markSyncing(operationId: String) {
        pendingOperationDao.updateOperationStatus(operationId, "SYNCING")
    }
    
    /**
     * Mark operation as synced (success)
     */
    suspend fun markSynced(operationId: String) {
        pendingOperationDao.updateOperationStatus(operationId, "SYNCED")
        Timber.d("Operation synced: $operationId")
    }
    
    /**
     * Mark operation as failed
     */
    suspend fun markFailed(operationId: String, error: String) {
        val operation = pendingOperationDao.getOperationById(operationId) ?: return
        
        val updatedOperation = operation.copy(
            status = "FAILED",
            retryCount = operation.retryCount + 1,
            lastError = error,
            updatedAt = System.currentTimeMillis()
        )
        
        pendingOperationDao.updatePendingOperation(updatedOperation)
        Timber.e("Operation failed: $operationId - $error (retry ${operation.retryCount}/${operation.maxRetries})")
    }
    
    /**
     * Clear all synced operations
     */
    suspend fun clearSyncedOperations() {
        pendingOperationDao.deleteSyncedOperations()
        Timber.d("Cleared synced operations")
    }
    
    /**
     * Get operation details
     */
    suspend fun getOperation(operationId: String): PendingOperation? {
        return pendingOperationDao.getOperationById(operationId)
    }
    
    /**
     * Delete operation from queue
     */
    suspend fun deleteOperation(operationId: String) {
        val operation = pendingOperationDao.getOperationById(operationId)
        if (operation != null) {
            pendingOperationDao.deletePendingOperation(operation)
        }
    }
}
