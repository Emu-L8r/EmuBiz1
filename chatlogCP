import javax.inject.Singleton
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

/**
 * Service for restoring data from backups
 */
@Singleton
class RestoreService @Inject constructor(
    @ApplicationContext private val context: Context,
    private val invoiceDao: InvoiceDao,
    private val customerDao: CustomerDao,
    private val lineItemDao: LineItemDao,
    private val gson: Gson
) {
    
    companion object {
        private const val TAG = "RestoreService"
    }
    
    /**
     * Restore from JSON backup
     */
    suspend fun restoreFromJsonBackup(
        backupFile: File,
        mergeWithExisting: Boolean = false
    ): RestoreResult = withContext(Dispatchers.IO) {
        try {
            Timber.d("RestoreService: Starting restore from ${backupFile.name}")
            
            // Parse backup
            val backupContent = backupFile.readText()
            val snapshot = gson.fromJson(backupContent, BackupSnapshot::class.java)
            
            // If not merging, clear existing data
            if (!mergeWithExisting) {
                Timber.d("RestoreService: Clearing existing data...")
                invoiceDao.deleteAllInvoices()
                customerDao.deleteAllCustomers()
                lineItemDao.deleteAllLineItems()
            }
            
            var importedInvoices = 0
            var importedCustomers = 0
            var importedLineItems = 0
            var failures = 0
            
            // Import customers first (no dependencies)
            snapshot.customers.forEach { customerBackup ->
                try {
                    val customer = Customer(
                        id = customerBackup.id,
                        businessProfileId = customerBackup.businessProfileId,
                        name = customerBackup.name,
                        email = customerBackup.email,
                        phone = customerBackup.phone,
                        address = customerBackup.address,
                        createdAt = customerBackup.createdAt,
                        updatedAt = customerBackup.updatedAt
                    )
                    customer.validate()
                    customerDao.insertCustomer(customer)
                    importedCustomers++
                } catch (e: Exception) {
                    Timber.e("RestoreService: Failed to import customer: ${e.message}")
                    failures++
                }
            }
            
            // Import invoices
            snapshot.invoices.forEach { invoiceBackup ->
                try {
                    val invoice = Invoice(
                        id = invoiceBackup.id,
                        businessProfileId = invoiceBackup.businessProfileId,
                        customerId = invoiceBackup.customerId,
                        invoiceNumber = invoiceBackup.invoiceNumber,
                        currencyCode = invoiceBackup.currencyCode,
                        subtotal = invoiceBackup.subtotal,
                        taxAmount = invoiceBackup.taxAmount,
                        totalAmount = invoiceBackup.totalAmount,
                        status = invoiceBackup.status,
                        createdAt = invoiceBackup.createdAt,
                        updatedAt = invoiceBackup.updatedAt
                    )
                    invoice.validate()
                    invoiceDao.insertInvoice(invoice)
                    importedInvoices++
                } catch (e: Exception) {
                    Timber.e("RestoreService: Failed to import invoice: ${e.message}")
                    failures++
                }
            }
            
            // Import line items
            snapshot.lineItems.forEach { itemBackup ->
                try {
                    val lineItem = LineItem(
                        id = itemBackup.id,
                        invoiceId = itemBackup.invoiceId,
                        description = itemBackup.description,
                        quantity = itemBackup.quantity,
                        unitPrice = itemBackup.unitPrice,
                        createdAt = itemBackup.createdAt
                    )
                    lineItem.validate()
                    lineItemDao.insertLineItem(lineItem)
                    importedLineItems++
                } catch (e: Exception) {
                    Timber.e("RestoreService: Failed to import line item: ${e.message}")
                    failures++
                }
            }
            
            Timber.d("RestoreService: Restore complete. Imported: $importedInvoices invoices, $importedCustomers customers, $importedLineItems items. Failures: $failures")
            
            return@withContext RestoreResult(
                success = true,
                importedInvoices = importedInvoices,
                importedCustomers = importedCustomers,
                importedLineItems = importedLineItems,
                failures = failures,
                message = "Restored $importedInvoices invoices, $importedCustomers customers"
            )
            
        } catch (e: Exception) {
            Timber.e("RestoreService: Failed to restore from backup: ${e.message}")
            return@withContext RestoreResult(
                success = false,
                message = "Restore failed: ${e.message}"
            )
        }
    }
    
    /**
     * Validate backup file before restore
     */
    suspend fun validateBackup(backupFile: File): Boolean = withContext(Dispatchers.IO) {
        try {
            val content = backupFile.readText()
            val snapshot = gson.fromJson(content, BackupSnapshot::class.java)
            
            // Check minimum requirements
            return@withContext snapshot.metadata != null && 
                   snapshot.invoices.isNotEmpty() &&
                   snapshot.customers.isNotEmpty()
        } catch (e: Exception) {
            Timber.e("RestoreService: Invalid backup file: ${e.message}")
            return@withContext false
        }
    }
}

/**
 * Result of restore operation
 */
data class RestoreResult(
    val success: Boolean,
    val importedInvoices: Int = 0,
    val importedCustomers: Int = 0,
    val importedLineItems: Int = 0,
    val failures: Int = 0,
    val message: String = ""
)
