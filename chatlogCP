// Pattern you'll use:

@Composable
fun RevenueChart(data: List<DailyRevenue>) {
    val entries = data.mapIndexed { index, rev ->
        Entry(index.toFloat(), rev.amount.toFloat())
    }
    
    AndroidView(
        modifier = Modifier.fillMaxWidth().height(300.dp),
        factory = { context ->
            LineChart(context).apply {
                this.data = LineData(LineDataSet(entries, "Revenue").apply {
                    color = Color.BLUE
                    setDrawCircles(false)
                })
                invalidate()
            }
        }
    )
}

// Simple, clean, effective
