@HiltViewModel
class PaymentAnalyticsViewModel @Inject constructor(
    private val getPaymentAnalyticsUseCase: GetPaymentAnalyticsUseCase,
    private val identifyRiskInvoicesUseCase: IdentifyRiskInvoicesUseCase,
    private val generateDunningNoticesUseCase: GenerateDunningNoticesUseCase,
    private val forecastCashFlowUseCase: ForecastCashFlowUseCase
) : ViewModel() {

    private val _state = MutableStateFlow<PaymentAnalyticsUiState>(
        PaymentAnalyticsUiState.Loading
    )
    val state: StateFlow<PaymentAnalyticsUiState> = _state.asStateFlow()

    private val businessProfileId = 1L

    init {
        loadPaymentAnalytics()
    }

    private fun loadPaymentAnalytics() {
        viewModelScope.launch {
            try {
                Timber.d("PaymentAnalyticsViewModel: Loading analytics for business $businessProfileId")
                _state.value = PaymentAnalyticsUiState.Loading

                val analytics = getPaymentAnalyticsUseCase.execute(businessProfileId)

                Timber.d(
                    "PaymentAnalyticsViewModel: Loaded analytics - " +
                    "Total: ${analytics.totalInvoices}, " +
                    "Outstanding: $${String.format("%.2f", analytics.totalOutstandingAmount)}, " +
                    "Collection Rate: ${String.format("%.1f", analytics.collectionRate)}%, " +
                    "Overdue: ${analytics.overdueInvoices}"
                )

                _state.value = PaymentAnalyticsUiState.Success(analytics)
            } catch (e: DataAccessException) {
                Timber.e(e, "PaymentAnalyticsViewModel: Data access error")
                _state.value = PaymentAnalyticsUiState.Error(
                    "Unable to load payment analytics. Please try again."
                )
            } catch (e: Exception) {
                Timber.e(e, "PaymentAnalyticsViewModel: Unexpected error")
                _state.value = PaymentAnalyticsUiState.Error(
                    "An unexpected error occurred: ${e.message}"
                )
            }
        }
    }

    fun retryLoadAnalytics() {
        loadPaymentAnalytics()
    }
}

sealed class PaymentAnalyticsUiState {
    object Loading : PaymentAnalyticsUiState()
    data class Success(val analytics: PaymentAnalyticsSummary) : PaymentAnalyticsUiState()
    data class Error(val message: String) : PaymentAnalyticsUiState()
}
