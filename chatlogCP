package com.emul8r.bizap.data.network

/**
 * Sealed class for API error types
 * Allows structured error handling throughout the app
 */
sealed class ApiException(message: String) : Exception(message) {
    
    /**
     * User's session expired or credentials invalid
     * UI should redirect to login
     */
    class AuthenticationException(message: String) : ApiException(message)
    
    /**
     * User doesn't have permission for this operation
     * UI should show permission denied message
     */
    class PermissionException(message: String) : ApiException(message)
    
    /**
     * Resource was not found on the server
     * UI should show 404 message
     */
    class NotFoundException(message: String) : ApiException(message)
    
    /**
     * Client sent invalid request (bad parameters, validation error)
     * UI should show validation error message
     */
    class ClientException(message: String) : ApiException(message)
    
    /**
     * Server error (500, 502, 503, etc.)
     * UI should show retry option
     */
    class ServerException(message: String) : ApiException(message)
    
    /**
     * Network timeout (request took too long)
     * UI should show timeout message and retry option
     */
    class TimeoutException(message: String) : ApiException(message)
    
    /**
     * No internet connection or network unreachable
     * UI should show offline message
     */
    class NetworkException(message: String) : ApiException(message)
    
    /**
     * Unknown error type
     * UI should show generic error message
     */
    class UnknownException(message: String) : ApiException(message)
}
