package com.emul8r.bizap.data.sync

import android.content.Context
import androidx.work.CoroutineWorker
import androidx.work.WorkerParameters
import com.emul8r.bizap.data.local.dao.PendingOperationDao
import com.emul8r.bizap.data.local.entity.PendingOperation
import com.emul8r.bizap.data.network.ApiException
import com.emul8r.bizap.data.repository.OfflineSyncQueue
import com.google.gson.Gson
import dagger.assisted.Assisted
import dagger.assisted.AssistedInject
import kotlinx.coroutines.delay
import timber.log.Timber

/**
 * WorkManager Worker that syncs pending operations to the server
 * Triggered when device comes online
 * Handles retries, conflicts, and partial failures
 */
class SyncWorker @AssistedInject constructor(
    @Assisted context: Context,
    @Assisted params: WorkerParameters,
    private val pendingOperationDao: PendingOperationDao,
    private val syncQueue: OfflineSyncQueue,
    private val gson: Gson,
    private val syncService: SyncService
) : CoroutineWorker(context, params) {
    
    companion object {
        private const val TAG = "SyncWorker"
        const val UNIQUE_WORK_NAME = "offline_sync"
        
        // Tag for sync notifications
        const val SYNC_PROGRESS_TAG = "sync_progress"
        const val SYNC_COMPLETE_TAG = "sync_complete"
    }
    
    override suspend fun doWork(): Result {
        return try {
            Timber.d("SyncWorker: Starting sync...")
            
            // Get all pending operations
            val pendingOps = pendingOperationDao.getPendingOperations()
            
            if (pendingOps.isEmpty()) {
                Timber.d("SyncWorker: No pending operations")
                return Result.success()
            }
            
            Timber.d("SyncWorker: Found ${pendingOps.size} pending operations")
            
            // Sync operations in order (FIFO)
            var successCount = 0
            var failureCount = 0
            
            pendingOps.forEachIndexed { index, operation ->
                try {
                    // Update progress (for UI notification)
                    val progress = ((index + 1).toFloat() / pendingOps.size.toFloat() * 100).toInt()
                    setProgress(
                        androidx.work.workDataOf(
                            "progress" to progress,
                            "synced" to (index + 1),
                            "total" to pendingOps.size
                        )
                    )
                    
                    // Sync operation
                    syncOperation(operation)
                    
                    // Mark as synced
                    syncQueue.markSynced(operation.id)
                    successCount++
                    
                    Timber.d("SyncWorker: Synced ${operation.operationType} ${operation.entityType}")
                    
                } catch (e: Exception) {
                    Timber.e("SyncWorker: Failed to sync operation: ${e.message}")
                    handleSyncFailure(operation, e)
                    failureCount++
                }
            }
            
            // Clean up synced operations
            syncQueue.clearSyncedOperations()
            
            Timber.d("SyncWorker: Sync complete. Success: $successCount, Failed: $failureCount")
            
            // Return retry if there were failures
            if (failureCount > 0) {
                Result.retry()
            } else {
                Result.success()
            }
            
        } catch (e: Exception) {
            Timber.e("SyncWorker: Unexpected error: ${e.message}")
            Result.retry()
        }
    }
    
    /**
     * Sync a single operation to the server
     */
    private suspend fun syncOperation(operation: PendingOperation) {
        // Mark as syncing
        syncQueue.markSyncing(operation.id)
        
        try {
            when (operation.operationType) {
                "CREATE" -> {
                    when (operation.entityType) {
                        "INVOICE" -> {
                            val invoiceJson = operation.payload
                            val response = syncService.createInvoice(invoiceJson)
                            Timber.d("Created invoice on server with ID: ${response.id}")
                        }
                        "CUSTOMER" -> {
                            val customerJson = operation.payload
                            val response = syncService.createCustomer(customerJson)
                            Timber.d("Created customer on server with ID: ${response.id}")
                        }
                        else -> throw IllegalArgumentException("Unknown entity type: ${operation.entityType}")
                    }
                }
                
                "UPDATE" -> {
                    when (operation.entityType) {
                        "INVOICE" -> {
                            val invoiceJson = operation.payload
                            val response = syncService.updateInvoice(operation.entityId!!, invoiceJson)
                            Timber.d("Updated invoice on server: ${response.id}")
                        }
                        "CUSTOMER" -> {
                            val customerJson = operation.payload
                            val response = syncService.updateCustomer(operation.entityId!!, customerJson)
                            Timber.d("Updated customer on server: ${response.id}")
                        }
                        else -> throw IllegalArgumentException("Unknown entity type: ${operation.entityType}")
                    }
                }
                
                "DELETE" -> {
                    when (operation.entityType) {
                        "INVOICE" -> {
                            syncService.deleteInvoice(operation.entityId!!)
                            Timber.d("Deleted invoice from server")
                        }
                        "CUSTOMER" -> {
                            syncService.deleteCustomer(operation.entityId!!)
                            Timber.d("Deleted customer from server")
                        }
                        else -> throw IllegalArgumentException("Unknown entity type: ${operation.entityType}")
                    }
                }
                
                else -> throw IllegalArgumentException("Unknown operation type: ${operation.operationType}")
            }
            
        } catch (e: ApiException.ServerException) {
            // Server error - retry
            throw e
        } catch (e: ApiException.TimeoutException) {
            // Timeout - retry
            throw e
        } catch (e: ApiException.NetworkException) {
            // Network error - retry
            throw e
        } catch (e: ApiException.ClientException) {
            // Client error (validation) - don't retry, mark as failed
            throw e
        }
    }
    
    /**
     * Handle sync failure with retry logic
     */
    private suspend fun handleSyncFailure(operation: PendingOperation, error: Exception) {
        val currentOp = pendingOperationDao.getOperationById(operation.id) ?: return
        
        if (currentOp.canRetry()) {
            // Exponential backoff: 1s, 2s, 4s, 8s
            val backoffMs = 1000L * (1 shl currentOp.retryCount) // 2^retryCount
            Timber.d("SyncWorker: Retrying in ${backoffMs}ms (attempt ${currentOp.retryCount + 1}/${currentOp.maxRetries})")
            
            delay(backoffMs)
            
            // Update retry count and error
            val updatedOp = currentOp.copy(
                status = "PENDING",
                retryCount = currentOp.retryCount + 1,
                lastError = error.message,
                updatedAt = System.currentTimeMillis()
            )
            pendingOperationDao.updatePendingOperation(updatedOp)
            
        } else {
            // Exceeded max retries - mark as failed
            Timber.e("SyncWorker: Exceeded max retries for operation ${operation.id}")
            syncQueue.markFailed(operation.id, "Max retries exceeded: ${error.message}")
        }
    }
}
