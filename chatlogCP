package com.emul8r.bizap.data.repository

import com.emul8r.bizap.data.network.NetworkConnectivityManager
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.distinctUntilChanged
import timber.log.Timber

/**
 * Base repository that is aware of offline mode
 * Provides helpers for offline-first operations
 */
abstract class OfflineAwareRepository(
    protected val connectivityManager: NetworkConnectivityManager,
    protected val syncQueue: OfflineSyncQueue
) {
    
    /**
     * Check if currently online
     */
    suspend fun isOnline(): Boolean {
        return connectivityManager.isInternetAvailable()
    }
    
    /**
     * Check if currently offline
     */
    suspend fun isOffline(): Boolean {
        return !isOnline()
    }
    
    /**
     * Observe connectivity changes
     */
    fun observeOnlineStatus(): Flow<Boolean> {
        return connectivityManager.observeConnectivity().distinctUntilChanged()
    }
    
    /**
     * Safely execute operation - queue if offline, execute if online
     */
    suspend fun <T> executeOrQueue(
        operationType: String,
        entityType: String,
        businessProfileId: Int,
        payload: T,
        entityId: Int? = null,
        onlineAction: suspend () -> Unit
    ) {
        if (isOnline()) {
            try {
                Timber.d("Online - executing $operationType $entityType immediately")
                onlineAction()
            } catch (e: Exception) {
                Timber.e("Online action failed: ${e.message} - queuing for later")
                syncQueue.queueOperation(operationType, entityType, businessProfileId, payload, entityId)
            }
        } else {
            Timber.d("Offline - queuing $operationType $entityType")
            syncQueue.queueOperation(operationType, entityType, businessProfileId, payload, entityId)
        }
    }
    
    /**
     * Observe pending operations count
     */
    fun observePendingOperationsCount(): Flow<Int> {
        return syncQueue.observePendingCount()
    }
    
    /**
     * Get pending operations for business
     */
    suspend fun getPendingOperations(businessProfileId: Int) {
        return syncQueue.getPendingOperations(businessProfileId)
    }
}
