<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Force the logo to scale to 60dp x 60dp.
        This fits within the 72dp Adaptive Icon 'Safe Zone'
        to ensure no text is clipped by the round/square mask.
    -->
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center"
        android:drawable="@drawable/company_logo" />
</layer-list>
