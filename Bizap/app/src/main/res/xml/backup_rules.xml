<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup Rules for Bizap - Security Hardening

   This file specifies which app data can be backed up and which should be excluded.

   Security Considerations:
   - Database (bizap.db) should NOT be backed up to Google Drive
   - SharedPreferences containing sensitive data should be excluded
   - Non-sensitive files (documents) can be safely backed up

   Last Updated: April 7, 2026

   Reference: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- 🔐 SECURITY: Explicitly include only safe paths, exclude sensitive data -->
    <include domain="file" path="documents/" />
    <include domain="cache" path="." />

    <!-- 🔐 SECURITY: Exclude sensitive database from backup -->
    <exclude domain="database" path="." />

    <!-- 🔐 SECURITY: Exclude SharedPreferences (may contain sensitive data) -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
