<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup Rules for Bizap - Security Hardening

   This file specifies which app data should be excluded from Google Cloud backups.

   Security Considerations:
   - Sensitive databases should NOT be backed up
   - SharedPreferences containing sensitive data should be excluded
   - By default, all other data (documents, cache) is backed up

   Last Updated: April 7, 2026
   Reference: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- 🔐 SECURITY: Exclude sensitive database from Google backup -->
    <exclude domain="database" path="bizap.db" />

    <!-- 🔐 SECURITY: Exclude SharedPreferences (may contain sensitive auth data) -->
    <exclude domain="sharedpref" path="com.emul8r.bizap_preferences.xml" />
</full-backup-content>
