<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Root access for all files in app's private storage (filesDir) -->
    <!-- This covers all subdirectories including documents/, exports/, cache/ -->
    <files-path name="root" path="." />

    <!-- Explicit references for clarity and documentation -->
    <files-path name="documents" path="documents/" />
    <files-path name="exports" path="exports/" />
    <files-path name="backups" path="backups/" />

    <!-- Cache directory for temporary files -->
    <cache-path name="cache" path="." />

    <!-- External files directory for Downloads folder -->
    <external-files-path name="external_documents" path="." />
</paths>
