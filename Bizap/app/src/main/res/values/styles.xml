<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================
         Material 3 Button Styles
         ================================================================ -->

    <!-- Filled button — high emphasis primary action -->
    <style name="Widget.Bizap.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:paddingStart">@dimen/spacing_24</item>
        <item name="android:paddingEnd">@dimen/spacing_24</item>
        <item name="cornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- Outlined button — medium emphasis secondary action -->
    <style name="Widget.Bizap.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:paddingStart">@dimen/spacing_24</item>
        <item name="android:paddingEnd">@dimen/spacing_24</item>
        <item name="cornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- Text button — low emphasis tertiary action -->
    <style name="Widget.Bizap.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:paddingStart">@dimen/spacing_12</item>
        <item name="android:paddingEnd">@dimen/spacing_12</item>
    </style>

    <!-- Elevated button — medium emphasis with shadow -->
    <style name="Widget.Bizap.Button.Elevated" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:paddingStart">@dimen/spacing_24</item>
        <item name="android:paddingEnd">@dimen/spacing_24</item>
        <item name="cornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- Tonal button — medium emphasis using secondary container -->
    <style name="Widget.Bizap.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:paddingStart">@dimen/spacing_24</item>
        <item name="android:paddingEnd">@dimen/spacing_24</item>
        <item name="cornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- ================================================================
         Material 3 Card Styles
         ================================================================ -->

    <!-- Elevated card — default, with shadow -->
    <style name="Widget.Bizap.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/spacing_16</item>
    </style>

    <!-- Outlined card — with border, no shadow -->
    <style name="Widget.Bizap.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_radius_medium</item>
        <item name="contentPadding">@dimen/spacing_16</item>
    </style>

    <!-- Filled card — surface tonal background -->
    <style name="Widget.Bizap.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_radius_medium</item>
        <item name="contentPadding">@dimen/spacing_16</item>
    </style>

    <!-- ================================================================
         Material 3 FloatingActionButton Styles
         ================================================================ -->

    <!-- Standard FAB -->
    <style name="Widget.Bizap.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Bizap.FAB</item>
    </style>

    <!-- Extended FAB — with text label -->
    <style name="Widget.Bizap.FloatingActionButton.Extended" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Bizap.FAB</item>
    </style>

    <style name="ShapeAppearance.Bizap.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_extra_large</item>
    </style>

    <!-- ================================================================
         Material 3 AppBar Styles
         ================================================================ -->

    <!-- Top App Bar — centered title -->
    <style name="Widget.Bizap.TopAppBar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">@dimen/top_bar_height</item>
    </style>

    <!-- ================================================================
         Material 3 TextField / TextInputLayout Styles
         ================================================================ -->

    <!-- Outlined text field -->
    <style name="Widget.Bizap.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_small</item>
    </style>

    <!-- Filled text field -->
    <style name="Widget.Bizap.TextInputLayout.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_small</item>
    </style>

    <!-- ================================================================
         Material 3 Chip Styles
         ================================================================ -->

    <!-- Input chip — for user-entered content -->
    <style name="Widget.Bizap.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="chipCornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- Filter chip — for filtering lists -->
    <style name="Widget.Bizap.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- Suggestion chip — for autocomplete suggestions -->
    <style name="Widget.Bizap.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">@dimen/corner_radius_small</item>
    </style>

    <!-- Assist chip — for assistive actions -->
    <style name="Widget.Bizap.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">@dimen/corner_radius_small</item>
    </style>

</resources>
